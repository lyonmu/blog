---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  featured?: boolean;
} & CollectionEntry<"blog">;

const {
  variant: Heading = "h2",
  featured = false,
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, ...props } = data;
---

<li
  class:list={["card-glow", { "featured-card": featured }]}
  data-tilt={featured || undefined}
>
  <div class="eyebrow mb-6">{data.tags.slice(0, 2).join(" / ")}</div>
  <a
    href={getPath(id, filePath)}
    style={{
      viewTransitionName: slugifyStr(String(title).replaceAll(".", "-")),
    }}><Heading class="text-xl leading-snug font-semibold">{title}</Heading></a
  >
  <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
    {description}
  </p>
  <div class="mt-6"><Datetime {...props} size="sm" /></div>
</li>
<style>
  .card-glow {
    position: relative;
    padding: 1.5rem;
    margin: 0.75rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      transform 220ms,
      border-color 220ms;
  }
  .card-glow a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card-glow:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .card-glow:hover {
    border-color: var(--border-hover);
  }
  @media (min-width: 768px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .featured-card:hover {
      transform: perspective(900px) translateY(-3px)
        rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
      background:
        radial-gradient(
          350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
          var(--glow),
          transparent
        ),
        var(--surface);
    }
  }
</style>
