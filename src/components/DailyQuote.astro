---
// DailyQuote.astro - 每日一句组件
// 从 https://v1.hitokoto.cn/ 获取每日一句

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={["daily-quote", className]} data-daily-quote>
  <span class="quote-content">事情有时不是你想的那样</span>
  <span class="quote-origin hidden"></span>
</p>

<script>
  let cleanup = () => {};

  async function fetchDailyQuote(): Promise<void> {
    cleanup();
    const elements =
      document.querySelectorAll<HTMLElement>("[data-daily-quote]");
    if (!elements.length) return;

    const controller = new AbortController();
    let active = true;
    const timeout = window.setTimeout(() => controller.abort(), 5000);
    cleanup = () => {
      active = false;
      controller.abort();
      window.clearTimeout(timeout);
    };

    try {
      // One request updates all instances on the current page.
      const response = await fetch("https://v1.hitokoto.cn/", {
        signal: controller.signal,
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data: { hitokoto?: unknown; from?: unknown; from_who?: unknown } =
        await response.json();
      if (!data || typeof data.hitokoto !== "string" || !data.hitokoto.trim())
        throw new Error("一言内容无效");
      if (!active) return;

      const quote = data.hitokoto;
      const origin = [data.from, data.from_who]
        .filter(
          (value): value is string =>
            typeof value === "string" && value.trim().length > 0
        )
        .join(" · ");
      elements.forEach(element => {
        const content = element.querySelector(".quote-content");
        const source = element.querySelector(".quote-origin");
        if (content) content.textContent = quote;
        if (source) {
          source.textContent = origin ? ` —— ${origin}` : "";
          source.classList.toggle("hidden", !origin);
        }
      });
    } catch {
      // Keep the server-rendered quote readable when the service is unavailable.
    } finally {
      window.clearTimeout(timeout);
    }
  }

  document.addEventListener("astro:page-load", fetchDailyQuote);
  document.addEventListener("astro:before-swap", () => cleanup());
</script>

<style>
  .daily-quote {
    margin: 0;
  }
  .quote-origin {
    opacity: 0.6;
  }
</style>
