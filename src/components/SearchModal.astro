---
import "@pagefind/default-ui/css/ui.css";
---

<dialog id="search-modal" aria-labelledby="search-dialog-title">
  <div class="dialog-heading">
    <h2 id="search-dialog-title" class="eyebrow">搜索笔记</h2><button
      data-search-close
      aria-label="关闭搜索">关闭 <kbd>Esc</kbd></button
    >
  </div>
  <div id="modal-pagefind-search" class="premium-search"></div>
  <p class="mt-5 text-xs text-muted-foreground">
    输入关键词搜索文章 · <a href="/search/" class="text-accent">打开搜索页 ↗</a>
  </p>
</dialog>
<script>
  let cleanup = () => {};
  function initSearchModal() {
    cleanup();
    const modal = document.querySelector<HTMLDialogElement>("#search-modal");
    if (!modal) return;
    const controller = new AbortController();
    const { signal } = controller;
    let loaded = false;
    let destroy = () => {};
    let previousFocus: HTMLElement | null = null;
    const close = () => modal.close();
    async function open() {
      if (!modal || modal.open) return;
      previousFocus = document.activeElement as HTMLElement;
      modal.showModal();
      if (loaded) {
        modal.querySelector<HTMLInputElement>("input")?.focus();
        return;
      }
      loaded = true;
      try {
        // @ts-expect-error - Pagefind does not provide UI declarations.
        const { PagefindUI } = await import("@pagefind/default-ui");
        if (signal.aborted) return;
        const search = new PagefindUI({
          element: "#modal-pagefind-search",
          showImages: false,
          showSubResults: true,
        });
        destroy = () => search.destroy();
        if (modal.open) modal.querySelector<HTMLInputElement>("input")?.focus();
      } catch {
        loaded = false;
        const container = modal.querySelector("#modal-pagefind-search");
        if (!signal.aborted && container)
          container.textContent = "搜索暂时无法加载，请刷新重试。";
      }
    }
    document
      .querySelectorAll("[data-search-trigger]")
      .forEach(button => button.addEventListener("click", open, { signal }));
    modal
      .querySelector("[data-search-close]")
      ?.addEventListener("click", close, { signal });
    modal.addEventListener(
      "click",
      event => {
        if (event.target === modal) {
          const rect = modal.getBoundingClientRect();
          if (
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom
          )
            close();
        }
      },
      { signal }
    );
    modal.addEventListener("close", () => previousFocus?.focus(), { signal });
    document.addEventListener(
      "keydown",
      event => {
        if (
          (event.metaKey || event.ctrlKey) &&
          event.key.toLowerCase() === "k"
        ) {
          event.preventDefault();
          if (modal.open) close();
          else void open();
        }
      },
      { signal }
    );
    cleanup = () => {
      controller.abort();
      modal.close();
      destroy();
    };
  }
  document.addEventListener("astro:page-load", initSearchModal);
  document.addEventListener("astro:before-swap", () => cleanup());
</script>
<style>
  dialog {
    width: min(680px, calc(100vw - 2rem));
    max-height: 80svh;
    margin: 12svh auto auto;
    padding: 1.5rem;
    color: var(--foreground);
    background: var(--surface);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(4px);
  }
  .dialog-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  button {
    font-size: 0.75rem;
    color: var(--muted-foreground);
    padding: 0.5rem;
  }
  kbd {
    font: 0.65rem var(--font-cartograph);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.2rem;
  }
</style>
