---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

type Props = MarkdownLayoutProps<{ title: string }>;

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header /><Breadcrumb />
  <main id="main-content" class="app-layout pb-16">
    <header class="page-intro">
      <p class="eyebrow">关于 / {SITE.author}</p><h1>
        云原生工程师<span class="text-accent">.</span>
      </h1><p>关注系统如何运行、如何被观测，以及如何持续演进。</p>
    </header>
    <div class="about-grid">
      <section>
        <h2 class="eyebrow mb-5">个人简介</h2><div class="app-prose">
          <slot />
        </div>
      </section>
      <section class="about-focus">
        <h2 class="eyebrow mb-5">技术方向</h2><ul>
          {
            [
              "Kubernetes",
              "可观测性",
              "智能运维",
              "分布式系统",
              "基础设施",
            ].map(area => <li>{area}</li>)
          }
        </ul><h2 class="eyebrow mt-10 mb-5">近期关注</h2><p>
          以人工智能增强可观测性，探索动态基线与自主运维。
        </p>
      </section>
    </div>
    <section class="mt-12 border-t border-border pt-8">
      <h2 class="eyebrow mb-5">工程之路</h2><p class="text-muted-foreground">
        从 Linux
        与网络，到云原生基础设施，再到可观测性与智能运维。工程实践持续记录在 <a
          href="/archives/"
          class="text-accent">文章归档 ↗</a
        >。
      </p>
    </section>
  </main><Footer />
</Layout>
<style>
  .about-grid :global(img) {
    max-width: 160px;
    margin-left: 0;
    border: 0;
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 3rem;
  }
  .about-focus {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  li {
    border-bottom: 1px solid var(--border);
    padding: 0.7rem 0;
  }
  .about-focus p {
    color: var(--muted-foreground);
    line-height: 1.8;
  }
  @media (max-width: 767px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
