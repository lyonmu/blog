---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import DailyQuote from "@/components/DailyQuote.astro";
import Card from "@/components/Card.astro";
import NoteRow from "@/components/blog/NoteRow.astro";
import HeroScene from "@/components/motion/HeroScene.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
const posts = getSortedPosts(await getCollection("blog"));
const featuredPosts = posts.filter(({ data }) => data.featured);
const recentPosts = posts.slice(0, SITE.postPerIndex);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section class="garden-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow" data-hero>
          <span class="status-dot"></span> ~/lyonmu
        </p>
        <h1 id="hero-title">
          <span data-hero>构建能够感知、</span><span data-hero
            >推理与持续演进的</span
          ><span data-hero>可靠系统。</span>
        </h1>
        <p class="hero-focus" data-hero>云原生 · 可观测性 · 智能运维</p>
        <p class="hero-description" data-hero>
          记录云原生、可观测性、智能运维与工程实践。
        </p>
        <div
          class="mt-4 max-w-lg border-l-2 border-border pl-3 text-sm leading-relaxed text-muted-foreground"
          data-hero
        >
          <DailyQuote />
        </div>
        <div class="hero-actions" data-hero>
          <a class="explore-link" data-magnetic href="/posts/"
            >探索笔记 <span aria-hidden="true">↗</span></a
          ><a class="eyebrow" href="/about/">关于我 →</a>
        </div>
        <p class="hero-meta eyebrow" data-hero>
          工程手记 <span> / </span>
          {posts.length} 篇笔记，持续更新
        </p>
      </div>
      <HeroScene />
    </section>
    {
      featuredPosts.length > 0 && (
        <section class="home-section" data-reveal>
          <>
            <div class="section-heading">
              <>
                <h2>精选文章</h2>
                <span class="eyebrow">值得一读</span>
              </>
            </div>
            <ul class="bento-grid">
              {featuredPosts.map(post => (
                <Card variant="h3" featured {...post} />
              ))}
            </ul>
          </>
        </section>
      )
    }
    <section class="home-section" data-reveal>
      <div class="section-heading">
        <h2>最近更新</h2><a class="eyebrow" href="/posts/">全部文章 ↗</a>
      </div><ul>
        {recentPosts.map((post, index) => <NoteRow {post} {index} />)}
      </ul>{!posts.length && <p>笔记正在整理中。</p>}
    </section>
    <div class="garden-colophon eyebrow">
      <span>云原生知识花园</span><a href="/rss.xml">订阅更新 ↗</a>
    </div>
  </main>
  <Footer />
</Layout>
<style>
  .garden-hero {
    display: grid;
    grid-template-columns: 55% 45%;
    align-items: center;
    min-height: 620px;
    padding: 4rem 0;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    margin-right: 0.5rem;
  }
  h1 {
    font-size: clamp(2.4rem, 4.2vw, 3.5rem);
    line-height: 1.13;
    letter-spacing: -0.055em;
    margin: 1.8rem 0;
    font-weight: 600;
  }
  h1 span {
    display: block;
  }
  h1 span:last-child {
    color: var(--accent);
  }
  .hero-focus {
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .hero-description {
    font-size: 0.9rem;
    color: var(--muted-foreground);
    margin-top: 0.6rem;
    line-height: 1.8;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin: 2rem 0;
  }
  .explore-link {
    display: inline-flex;
    gap: 2rem;
    padding: 0.9rem 1.2rem;
    background: var(--foreground);
    color: var(--background);
    border-radius: 0.5rem;
    font-size: 0.9rem;
    transition: transform 180ms;
  }
  .hero-meta {
    font-size: 0.6rem;
    line-height: 1.8;
  }
  .hero-meta span {
    padding: 0 0.5rem;
  }
  .home-section {
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
  }
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .bento-grid :global(li) {
    margin: 0;
    min-height: 210px;
  }
  .bento-grid :global(li:first-child:nth-last-child(odd)) {
    grid-column: 1 / -1;
  }
  .garden-colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding: 2.5rem 0 4rem;
    font-size: 0.6rem;
  }
  @media (max-width: 767px) {
    .garden-hero {
      grid-template-columns: 1fr;
      padding: 3rem 0 1rem;
    }
    h1 {
      font-size: clamp(2.2rem, 6.8vw, 3.6rem);
    }
    .bento-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
