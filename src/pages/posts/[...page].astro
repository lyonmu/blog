---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import NoteRow from "@/components/blog/NoteRow.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import Pagination from "@/components/Pagination.astro";
import "@pagefind/default-ui/css/ui.css";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const totalPosts = page.total;
const allPosts = getSortedPosts(await getCollection("blog"));
const topics = getUniqueTags(allPosts).slice(0, 8);
const years = [
  ...new Set(page.data.map(post => post.data.pubDatetime.getFullYear())),
];
---

<Layout title={`文章 | ${SITE.title}`}>
  <Header /><Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <header class="page-intro">
      <p class="eyebrow">工程手记 / {totalPosts} 篇文章</p><h1>
        文章笔记<span class="text-accent">.</span>
      </h1><p>云原生、基础设施与工程实践的持续记录。</p>
    </header>
    <nav class="topic-links" aria-label="按标签浏览">
      <a href="/posts/" aria-current="page">全部</a>{
        topics.map(tag => <a href={`/tags/${tag.tag}/`}>{tag.tagName}</a>)
      }
    </nav>
    <div id="posts-pagefind" class="premium-search mb-8"></div>
    <div data-default-posts-container>
      {
        years.map(year => (
          <section class="mb-8">
            <>
              <h2 class="eyebrow border-b border-border py-3">{year}</h2>
              <ul>
                {page.data
                  .filter(post => post.data.pubDatetime.getFullYear() === year)
                  .map((post, index) => (
                    <NoteRow {post} {index} />
                  ))}
              </ul>
            </>
          </section>
        ))
      }
      {!page.data.length && <p>暂无文章。</p>}
      <div data-pagination-wrapper><Pagination {page} /></div>
    </div>
  </main><Footer noMarginTop={page.lastPage > 1} />
</Layout>
<script>
  let cleanupController: AbortController | null = null;
  let destroySearch = () => {};

  function initPostsPage() {
    if (cleanupController) cleanupController.abort();
    destroySearch();
    cleanupController = new AbortController();
    const { signal } = cleanupController;

    // Initialize Pagefind local search
    const container = document.querySelector("#posts-pagefind");
    if (!container || container.childElementCount > 0) return;

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));
    onIdle(async () => {
      if (signal.aborted) return;
      if (container.childElementCount > 0) return;

      // @ts-expect-error - PagefindUI is dynamically imported and has no type definitions
      const { PagefindUI } = await import("@pagefind/default-ui");

      // Navigation may have occurred while the module was loading (first load, uncached)
      if (signal.aborted || container.childElementCount > 0) return;

      if (import.meta.env.DEV) {
        container.innerHTML = `
          <div class="bg-muted/75 rounded p-4 text-sm mb-4 border border-border">
            <p><strong>开发模式：</strong>搜索将尝试使用最近构建的索引。如果看不到结果，请先运行 <code>bun run build</code>。</p>
          </div>
        `;
        // Removed the early return to allow pagefind to attempt loading the local index
      }

      const search = new PagefindUI({
        element: "#posts-pagefind",
        showImages: false,
        showSubResults: true,
      });

      destroySearch = () => search.destroy();

      // Toggle default posts grid visibility when typing
      const input = container.querySelector(
        ".pagefind-ui__search-input"
      ) as HTMLInputElement;
      const defaultContainer = document.querySelector(
        "[data-default-posts-container]"
      ) as HTMLElement;

      if (input && defaultContainer) {
        const toggleVisibility = () => {
          const hasValue = input.value.trim().length > 0;
          if (hasValue) {
            defaultContainer.style.display = "none";
          } else {
            defaultContainer.style.display = "";
          }
        };

        input.addEventListener("input", toggleVisibility, { signal });

        // Handle clear button
        const clearBtn = container.querySelector(".pagefind-ui__search-clear");
        if (clearBtn) {
          clearBtn.addEventListener(
            "click",
            () => {
              requestAnimationFrame(() => toggleVisibility());
            },
            { signal }
          );
        }
      }

      // Intercept Global Cmd+K / Ctrl+K to focus inline search instead of Modal
      const handleCmdK = (e: KeyboardEvent) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          e.preventDefault();
          e.stopPropagation();
          if (input) {
            input.focus();
            // Scroll to the search box if it's not visible
            input.scrollIntoView({ behavior: "smooth", block: "center" });
          }
        }
      };

      // Use capture mode to intercept before the global modal listener
      document.addEventListener("keydown", handleCmdK, {
        signal,
        capture: true,
      });
    });
  }

  document.addEventListener("astro:before-swap", () => {
    cleanupController?.abort();
    destroySearch();
    destroySearch = () => {};
  });
  document.addEventListener("astro:page-load", initPostsPage);
</script>
