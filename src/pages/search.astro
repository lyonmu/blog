---
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";
---

<Layout title={`搜索 | ${SITE.title}`}>
  <Header /><Breadcrumb />
  <main id="main-content" class="app-layout pb-16">
    <header class="page-intro">
      <p class="eyebrow">寻找一篇笔记 / ⌘ K</p><h1>
        搜索<span class="text-accent">.</span>
      </h1><p>搜索文章、技术主题与工程实践。</p>
    </header>
    <div id="pagefind-search" class="premium-search"></div>
  </main><Footer />
</Layout>
<script>
  let cleanup = () => {};
  async function initSearch() {
    cleanup();
    const container = document.querySelector<HTMLElement>("#pagefind-search");
    if (!container) return;
    let active = true;
    let destroy = () => {};
    cleanup = () => {
      active = false;
      destroy();
    };
    try {
      // @ts-expect-error - Pagefind does not provide UI declarations.
      const { PagefindUI } = await import("@pagefind/default-ui");
      if (!active) return;
      const search = new PagefindUI({
        element: "#pagefind-search",
        showImages: false,
        showSubResults: true,
        processTerm: (term: string) => {
          const url = new URL(location.href);
          if (term) url.searchParams.set("q", term);
          else url.searchParams.delete("q");
          history.replaceState(history.state, "", url);
          sessionStorage.setItem("backUrl", url.pathname + url.search);
          return term;
        },
      });
      destroy = () => search.destroy();
      const query = new URLSearchParams(location.search).get("q");
      if (query) search.triggerSearch(query);
    } catch {
      if (active) container.textContent = "搜索暂时无法加载，请刷新重试。";
    }
  }
  document.addEventListener("astro:page-load", initSearch);
  document.addEventListener("astro:before-swap", () => cleanup());
</script>
