---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";
const posts = await getCollection("blog");
const tags = getUniqueTags(posts).map(({ tag, tagName }) => ({
  tag,
  tagName,
  count: getPostsByTag(posts, tag).length,
}));
---

<Layout title={`标签 | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout pb-16">
    <header class="atlas-heading">
      <p class="eyebrow">知识宇宙</p><h1>每一份好奇，都有自己的星系。</h1><p>
        云原生、系统与工程实践，沿着兴趣探索新的坐标。
      </p>
    </header>
    <section class="universe" data-universe aria-label="标签宇宙">
      <div class="universe-toolbar">
        <span
          >✦ &nbsp; 主题星系 <small
            >/ {String(tags.length).padStart(2, "0")} 个主题</small
          ></span
        ><button data-fullscreen aria-pressed="false" hidden
          ><span aria-hidden="true">⛶</span>
          <span data-fullscreen-label>全屏查看</span></button
        >
      </div>
      <div class="universe-layout">
        <div class="cosmos" data-cosmos>
          <div class="canvas-host" data-canvas-host aria-hidden="true"></div>
          <div class="planet-labels" data-planet-labels></div>
          <p class="scene-status" data-scene-status role="status">
            正在点亮星系…
          </p>
          <div class="coordinates" aria-hidden="true">
            知识观测站<br />23° 26′ · 好奇不止
          </div>
          <div class="scene-controls">
            <button data-universe-pause hidden>暂停公转</button><button
              data-universe-reset
              hidden>重置视角</button
            >
          </div>
        </div>
        <aside class="universe-info">
          <p class="eyebrow">让每个想法，自成星系</p><h2>
            以知识为星，<br />以好奇为引。
          </h2><p>
            每个标签是一颗主星球。<br />每收录一篇文章，就多一颗卫星。
          </p><div class="tag-selection" aria-live="polite" aria-atomic="true">
            <span class="eyebrow">正在探索</span><strong data-tag-name
              >随兴趣出发</strong
            ><span data-tag-count>{tags.length} 个主题，等待发现</span>
          </div><p class="interaction-guide">
            拖动旋转 · 滚轮或双指缩放<br />点击星球名称，进入主题
          </p>
        </aside>
      </div>
      <div class="universe-bottom">
        <span><i></i> 一个主题，一方天地</span><span>收录越多，星系越繁盛</span>
      </div>
    </section>
    <details class="tag-directory" open data-tag-directory>
      <summary>浏览全部标签 <span>{tags.length} 个主题</span></summary><div
        data-tag-field
      >
        <ul class="tag-matrix">
          {
            tags.map(({ tag, tagName, count }) => (
              <li>
                <a
                  href={`/tags/${tag}/`}
                  data-tag-node
                  data-name={tagName}
                  data-count={count}
                >
                  <span class="tag-dot" aria-hidden="true" />
                  {tagName}
                  <small>{count}</small>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </details>
  </main><Footer />
</Layout>
<style>
  :global(html.tag-universe-expanded) {
    overflow: hidden;
  }
  .atlas-heading {
    padding: 3.5rem 0 2rem;
  }
  .atlas-heading h1 {
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    margin: 1rem 0;
  }
  .atlas-heading > p:last-child {
    color: var(--muted-foreground);
    font-size: 0.8rem;
  }
  .universe {
    --universe-bg: #f0f5fa;
    --universe-text: #24384b;
    --universe-muted: #526b80;
    --universe-border: #b8ccdc80;
    --universe-button: #ffffffb3;
    --universe-hover: #dceaf3;
    --universe-label: #f6faffde;
    --universe-accent: #236b80;
    --universe-glow: #aacdde40;
    --universe-label-shadow: transparent;
    position: relative;
    border: 1px solid var(--universe-border);
    border-radius: 1.5rem;
    overflow: hidden;
    background: var(--universe-bg);
    color: var(--universe-text);
    box-shadow: 0 24px 80px #020b1820;
  }
  :global(html[data-theme="dark"]) .universe {
    --universe-bg: #060d1a;
    --universe-text: #dbe8f4;
    --universe-muted: #8fa4ba;
    --universe-border: #698aa330;
    --universe-button: #0e1c2c;
    --universe-hover: #21354b;
    --universe-label: #06101bc4;
    --universe-accent: #87d0df;
    --universe-glow: #14324b55;
    --universe-label-shadow: #000;
  }
  .universe-toolbar,
  .universe-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 1.6rem;
    font: 0.65rem var(--font-cartograph);
    letter-spacing: 0.1em;
  }
  .universe-toolbar {
    border-bottom: 1px solid var(--universe-border);
    min-height: 74px;
  }
  .universe-toolbar small {
    color: var(--universe-muted);
    margin-left: 0.6rem;
  }
  .universe button {
    border: 1px solid var(--universe-border);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    color: var(--universe-text);
    background: var(--universe-button);
    font-size: 0.7rem;
    letter-spacing: 0;
    cursor: pointer;
  }
  .universe button:hover {
    background: var(--universe-hover);
  }
  .universe :focus-visible {
    outline: 2px solid var(--universe-accent);
    outline-offset: 4px;
  }
  .universe-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
  }
  .cosmos {
    position: relative;
    height: 600px;
    min-width: 0;
    overflow: hidden;
    background: radial-gradient(
      ellipse at 45% 45%,
      var(--universe-glow),
      transparent 65%
    );
  }
  .canvas-host,
  .planet-labels {
    position: absolute;
    inset: 0;
  }
  .canvas-host :global(canvas) {
    width: 100%;
    height: 100%;
    touch-action: none;
  }
  .planet-labels {
    pointer-events: none;
  }
  .planet-labels :global(a) {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: auto;
    color: var(--universe-text);
    font-size: 0.65rem;
    padding: 5px 9px;
    border-radius: 8px;
    text-shadow: 0 2px 5px var(--universe-label-shadow);
    background: var(--universe-label);
    border: 1px solid var(--universe-border);
    white-space: nowrap;
  }
  .planet-labels :global(a:hover),
  .planet-labels :global(a:focus-visible) {
    color: var(--universe-accent);
    background: var(--universe-hover);
    z-index: 5 !important;
  }
  .coordinates {
    position: absolute;
    bottom: 1.4rem;
    left: 1.5rem;
    font: 0.5rem/1.8 var(--font-cartograph);
    letter-spacing: 0.09em;
    color: var(--universe-muted);
    pointer-events: none;
  }
  .scene-controls {
    position: absolute;
    bottom: 1.2rem;
    right: 1rem;
    display: flex;
    gap: 0.5rem;
  }
  .scene-status {
    position: absolute;
    top: 40%;
    width: 100%;
    text-align: center;
    color: var(--universe-muted);
    font-size: 0.85rem;
  }
  .universe-info {
    padding: 4rem 1.7rem 2rem 1rem;
    align-self: center;
  }
  .universe-info .eyebrow {
    font-size: 0.5rem;
    color: var(--universe-accent);
  }
  .universe-info h2 {
    font-size: 1.9rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: -0.045em;
    margin: 1rem 0;
  }
  .universe-info p:not(.eyebrow) {
    color: var(--universe-muted);
    font-size: 0.75rem;
    line-height: 2;
  }
  .tag-selection {
    border-left: 1px solid var(--universe-accent);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-left: 1rem;
    margin: 2.5rem 0;
    min-height: 105px;
  }
  .tag-selection strong {
    font-size: 1.2rem;
    font-weight: 400;
    overflow-wrap: anywhere;
  }
  .tag-selection > span:last-child {
    color: var(--universe-muted);
    font-size: 0.7rem;
  }
  .universe-bottom {
    border-top: 1px solid var(--universe-border);
    color: var(--universe-muted);
    font-size: 0.55rem;
  }
  .universe-bottom i {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--universe-accent);
    margin-right: 0.5rem;
    box-shadow: 0 0 10px var(--universe-accent);
  }
  .tag-directory {
    margin-top: 1.5rem;
    padding: 1rem 0;
  }
  .tag-directory summary {
    cursor: pointer;
    font-size: 0.85rem;
  }
  .tag-directory summary span {
    margin-left: 1rem;
    color: var(--muted-foreground);
    font-size: 0.7rem;
  }
  .tag-matrix {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.7rem;
    margin-top: 1rem;
  }
  .tag-matrix a {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    font-size: 0.75rem;
  }
  .tag-matrix a:hover {
    background: var(--glow);
  }
  .tag-matrix small {
    margin-left: auto;
    color: var(--muted-foreground);
  }
  .tag-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .universe:fullscreen,
  .universe.expanded {
    width: 100%;
    height: 100dvh;
    border-radius: 0;
    display: flex;
    flex-direction: column;
  }
  .universe.expanded {
    position: fixed;
    inset: 0;
    z-index: 100;
  }
  .universe:fullscreen .universe-layout,
  .universe.expanded .universe-layout {
    flex: 1;
    min-height: 0;
  }
  .universe:fullscreen .cosmos,
  .universe.expanded .cosmos {
    height: 100%;
  }
  @media (max-width: 767px) {
    .atlas-heading {
      padding-top: 2rem;
    }
    .universe-toolbar {
      padding: 1rem;
      font-size: 0.55rem;
    }
    .universe-toolbar small {
      display: none;
    }
    .universe-layout {
      grid-template-columns: 1fr;
    }
    .cosmos {
      height: 470px;
    }
    .universe-info {
      padding: 1.5rem;
      border-top: 1px solid var(--universe-border);
    }
    .universe-info h2,
    .universe-info > .eyebrow,
    .universe-info > p:not(.interaction-guide) {
      display: none;
    }
    .tag-selection {
      margin: 0 0 1rem;
      min-height: 0;
    }
    .universe-bottom {
      padding: 1rem;
      font-size: 0.45rem;
    }
    .coordinates {
      bottom: 4rem;
      left: 1rem;
    }
    .universe:fullscreen .universe-info,
    .universe.expanded .universe-info {
      display: none;
    }
  }
</style>
<script src="../../scripts/motion/tags.ts"></script>
<script src="../../scripts/motion/tagUniverse.ts"></script>
